# ==============================================================================
# UNIFIED ATC TERMINAL SAFETY SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server & Runtime
BACKEND_HOST=0.0.0.0    // Host address for the backend server
BACKEND_PORT=8000       // Port number for the backend server
FRONTEND_PORT=3000      // Port number for the frontend server
LOG_LEVEL=info          // Logging level for the application (e.g., debug, info, warn, error)

# OpenSky Network API (OAuth2 Client Credentials)
OPENSKY_CLIENT_ID="your_opensky_client_id_here"                                                                 // Client ID for OAuth2 authentication with OpenSky Network
OPENSKY_CLIENT_SECRET="your_opensky_client_secret_here"                                                         // Client credentials for OAuth2 authentication with OpenSky Network
OPENSKY_TOKEN_URL="https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token"  // URL for obtaining OAuth2 access tokens from OpenSky Network
OPENSKY_API_URL="https://opensky-network.org/api/states/all"                                                    // URL for accessing the OpenSky Network API to retrieve aircraft state data
OPENSKY_POLL_INTERVAL_SECONDS=120                                                                               // Interval in seconds for polling the OpenSky API for aircraft state data (270 request/day)

# OpenWeatherMap API
OPENWEATHER_API_KEY="your_openweather_api_key_here"                         // API key for accessing the OpenWeatherMap API
OPENWEATHER_BASE_URL="https://api.openweathermap.org/data/2.5/weather"      // Base URL for accessing the OpenWeatherMap API to retrieve weather data

# Active Target Airport Selection (Key matching config/airports.json)
ACTIVE_AIRPORT_CODE="DEL"       // IATA code of the active target airport for which the system will monitor and analyze air traffic and weather conditions

# Trajectory & Collision Safety Parameters
PREDICTION_HORIZON_SECONDS=60               // Time horizon in seconds for predicting aircraft trajectories and potential collision risks
AIRBORNE_MIN_HORIZONTAL_SEPARATION_NM=3.0   // Minimum horizontal separation distance in nautical miles required between airborne aircraft to ensure safe operations
AIRBORNE_MIN_VERTICAL_SEPARATION_FT=1000    // Minimum vertical separation distance in feet required between airborne aircraft to ensure safe operations
GROUND_STOPPING_BASE_DISTANCE_M=300         // Base distance in meters for calculating stopping distances of aircraft on the ground, used for collision avoidance and safety assessments
RAIN_FRICTION_PENALTY_FACTOR=1.6            // Friction penalty factor applied to ground stopping distance calculations during rainy conditions, accounting for reduced friction and increased stopping distances